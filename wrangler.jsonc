{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "folio-finance",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "folio-accounts",
			"database_id": "5bef4e6f-c463-4744-8880-77b06c665178",
			"migrations_dir": "migrations"
		}
	]
}